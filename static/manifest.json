{
	"short_name": "Catenary",
	"name": "Catenary Maps",
	"id": "catenarymaps",
	"display_override": [
		"window-controls-overlay"
	],
	"display": "standalone",
	"scope": "https://maps.catenarymaps.org",
	"categories": [
		"utilities",
		"travel",
		"navigation"
	],
	"orientation": "any",
	"icons": [
		{
			"src": "/appimages/icon-any.png",
			"type": "image/png",
			"sizes": "1024x1024",
			"purpose": "any"
		},
		{
			"src": "/appimages/icon-maskable.png",
			"type": "image/png",
			"sizes": "1024x1024",
			"purpose": "maskable"
		},
		{
			"src": "/appimages/icon-monochrome.png",
			"type": "image/png",
			"sizes": "1024x1024",
			"purpose": "monochrome"
		}
	],
	"protocol_handlers": [
		{
			"protocol": "web+catenary",
			"url": "/#%s"
		}
	],
	"screenshots": [
		{
			"src": "wide-screenshot.png",
			"sizes": "2077x1497",
			"type": "image/png",
			"form_factor": "wide"
		},
		{
			"src": "phone-screenshot.png",
			"sizes": "480x1043",
			"type": "image/png",
			"form_factor": "narrow"
		}
	],
	"start_url": "/?utm_source=pwa",
	"background_color": "#0a233f",
	"theme_color": "#00AB9B",
	"description": "Catenary helps connect people and communities with powerful transit data and algorithms.",
	"lang": "en",
	"prefer_related_applications": false
}
